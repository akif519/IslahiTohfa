@{
    ViewData["Title"] = "ہمارے بارے میں";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-10">
            <!-- Page Header -->
            <div class="text-center mb-5">
                <h1 class="display-4 fw-bold">
                    <i class="fas fa-info-circle text-primary ms-3"></i>
                    ہمارے بارے میں
                </h1>
                <p class="lead text-muted">اصلاحی تحفہ - اسلامی علوم کی ڈیجیٹل لائبریری</p>
            </div>

            <!-- Mission Section -->
            <div class="card card-custom mb-4">
                <div class="card-body p-5">
                    <h3 class="h4 mb-4">
                        <i class="fas fa-bullseye text-primary ms-2"></i>
                        ہمارا مقصد
                    </h3>
                    <p class="lead">
                        اصلاحی تحفہ ایک غیر منافع بخش اسلامی ڈیجیٹل لائبریری ہے جس کا مقصد اسلامی کتابوں کو آسانی سے دستیاب کرنا ہے۔
                    </p>
                    <p>
                        ہم اپنے قارئین کو اعلیٰ معیار کی اسلامی کتابیں مفت فراہم کرتے ہیں تاکہ وہ اسلامی علوم سے بہرہ مند ہو سکیں۔
                    </p>
                </div>
            </div>

            <!-- Features Section -->
            <div class="row g-4 mb-4">
                <div class="col-md-6">
                    <div class="card card-custom h-100">
                        <div class="card-body text-center p-4">
                            <div class="text-primary mb-3">
                                <i class="fas fa-book-open fa-3x"></i>
                            </div>
                            <h5>وسیع مجموعہ</h5>
                            <p class="text-muted mb-0">
                                قرآن، حدیث، فقہ، عقیدہ، سیرت اور دیگر موضوعات پر کتابیں
                            </p>
                        </div>
                    </div>
                </div>
                
                <div class="col-md-6">
                    <div class="card card-custom h-100">
                        <div class="card-body text-center p-4">
                            <div class="text-success mb-3">
                                <i class="fas fa-download fa-3x"></i>
                            </div>
                            <h5>مفت ڈاؤن لوڈ</h5>
                            <p class="text-muted mb-0">
                                تمام کتابیں مکمل طور پر مفت اور بغیر کسی پابندی کے دستیاب
                            </p>
                        </div>
                    </div>
                </div>
                
                <div class="col-md-6">
                    <div class="card card-custom h-100">
                        <div class="card-body text-center p-4">
                            <div class="text-warning mb-3">
                                <i class="fas fa-mobile-alt fa-3x"></i>
                            </div>
                            <h5>موبائل فرینڈلی</h5>
                            <p class="text-muted mb-0">
                                تمام آلات پر آسانی سے استعمال کی جا سکتی ہے
                            </p>
                        </div>
                    </div>
                </div>
                
                <div class="col-md-6">
                    <div class="card card-custom h-100">
                        <div class="card-body text-center p-4">
                            <div class="text-info mb-3">
                                <i class="fas fa-search fa-3x"></i>
                            </div>
                            <h5>آسان تلاش</h5>
                            <p class="text-muted mb-0">
                                مطلوبہ کتاب تیزی سے تلاش کریں
                            </p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Categories Section -->
            <div class="card card-custom">
                <div class="card-body p-5">
                    <h3 class="h4 mb-4">
                        <i class="fas fa-th-large text-primary ms-2"></i>
                        موضوعات
                    </h3>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <div class="d-flex align-items-center">
                                <i class="fas fa-book text-primary ms-3"></i>
                                <div>
                                    <h6 class="mb-0">قرآن کریم</h6>
                                    <small class="text-muted">تفاسیر اور تراجم</small>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6 mb-3">
                            <div class="d-flex align-items-center">
                                <i class="fas fa-book text-success ms-3"></i>
                                <div>
                                    <h6 class="mb-0">حدیث</h6>
                                    <small class="text-muted">صحاح ستہ اور دیگر مجموعے</small>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6 mb-3">
                            <div class="d-flex align-items-center">
                                <i class="fas fa-book text-warning ms-3"></i>
                                <div>
                                    <h6 class="mb-0">فقہ</h6>
                                    <small class="text-muted">مسائل اور احکام</small>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6 mb-3">
                            <div class="d-flex align-items-center">
                                <i class="fas fa-book text-info ms-3"></i>
                                <div>
                                    <h6 class="mb-0">عقیدہ</h6>
                                    <small class="text-muted">توحید اور ایمانیات</small>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6 mb-3">
                            <div class="d-flex align-items-center">
                                <i class="fas fa-book text-danger ms-3"></i>
                                <div>
                                    <h6 class="mb-0">سیرت</h6>
                                    <small class="text-muted">نبوی اور صحابہ کی سیرت</small>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6 mb-3">
                            <div class="d-flex align-items-center">
                                <i class="fas fa-book text-secondary ms-3"></i>
                                <div>
                                    <h6 class="mb-0">تاریخ</h6>
                                    <small class="text-muted">اسلامی تاریخ</small>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- CTA Section -->
            <div class="text-center mt-5">
                <h3 class="mb-4">کتابوں کا مطالعہ شروع کریں</h3>
                <a asp-controller="Book" asp-action="Index" class="btn btn-primary btn-lg px-5">
                    <i class="fas fa-book-open ms-2"></i>
                    کتابیں دیکھیں
                </a>
            </div>
        </div>
    </div>
</div>
