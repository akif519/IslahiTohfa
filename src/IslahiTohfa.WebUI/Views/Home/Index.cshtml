@using IslahiTohfa.WebUI.Helpers
@{
    ViewData["Title"] = LocalizationHelper.GetText("Home", Context);
    var featuredBooks = ViewBag.FeaturedBooks as IEnumerable<BookDto> ?? Enumerable.Empty<BookDto>();
    var recentBooks = ViewBag.RecentBooks as IEnumerable<BookDto> ?? Enumerable.Empty<BookDto>();
    var popularBooks = ViewBag.PopularBooks as IEnumerable<BookDto> ?? Enumerable.Empty<BookDto>();
    var dir = LocalizationHelper.GetDirection(Context);
}

<!-- Hero Section -->
<section class="hero-section py-5" style="background: linear-gradient(135deg, #2c7a7b 0%, #38b2ac 100%);">
    <div class="container text-center text-white">
        <div class="row justify-content-center">
            <div class="col-lg-8">
                <h1 class="display-4 fw-bold mb-4">
                    <i class="fas fa-book-open @(dir == "rtl" ? "ms-3" : "me-3")"></i>
                    @LocalizationHelper.GetText("AppName", Context)
                </h1>
                <p class="lead mb-4">
                    @LocalizationHelper.GetText("Tagline", Context)
                </p>
                <form asp-controller="Book" asp-action="Index" method="get" class="mt-4">
                    <div class="input-group input-group-lg">
                        <input type="text" name="SearchTerm" class="form-control" placeholder="@LocalizationHelper.GetText("SearchPlaceholder", Context)">
                        <button class="btn btn-light" type="submit">
                            <i class="fas fa-search"></i>
                            @LocalizationHelper.GetText("Search", Context)
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</section>

<!-- Featured Books Section -->
@if (featuredBooks.Any())
{
    <section class="py-5">
        <div class="container">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h2 class="h3 mb-0">
                    <i class="fas fa-star text-warning @(dir == "rtl" ? "ms-2" : "me-2")"></i>
                    @LocalizationHelper.GetText("FeaturedBooks", Context)
                </h2>
                <a asp-controller="Book" asp-action="Index" class="btn btn-outline-primary">
                    @LocalizationHelper.GetText("ViewAll", Context)
                    <i class="fas fa-arrow-@(dir == "rtl" ? "left" : "right") @(dir == "rtl" ? "me-2" : "ms-2")"></i>
                </a>
            </div>
            
            <div class="row g-4">
                @foreach (var book in featuredBooks)
                {
                    <div class="col-lg-4 col-md-6">
                        <div class="card card-custom h-100">
                            @if (!string.IsNullOrEmpty(book.CoverImagePath))
                            {
                                <img src="/@book.CoverImagePath" class="card-img-top book-cover" alt="@book.Title">
                            }
                            else
                            {
                                <div class="book-cover bg-secondary d-flex align-items-center justify-content-center">
                                    <i class="fas fa-book fa-5x text-white"></i>
                                </div>
                            }
                            <div class="card-body">
                                <h5 class="card-title">@book.Title</h5>
                                <p class="card-text text-muted">
                                    <i class="fas fa-user @(dir == "rtl" ? "ms-1" : "me-1")"></i>
                                    @book.Author
                                </p>
                                <div class="d-flex justify-content-between align-items-center">
                                    <div class="rating-stars">
                                        @for (int i = 0; i < 5; i++)
                                        {
                                            <i class="fas fa-star"></i>
                                        }
                                    </div>
                                    <small class="text-muted">
                                        <i class="fas fa-eye @(dir == "rtl" ? "ms-1" : "me-1")"></i>
                                        @book.ViewCount
                                    </small>
                                </div>
                            </div>
                            <div class="card-footer bg-transparent border-top-0">
                                <a asp-controller="Book" asp-action="Details" asp-route-id="@book.Id" class="btn btn-primary w-100">
                                    <i class="fas fa-book-reader @(dir == "rtl" ? "ms-2" : "me-2")"></i>
                                    @LocalizationHelper.GetText("Details", Context)
                                </a>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </section>
}

<!-- Recent Books Section -->
@if (recentBooks.Any())
{
    <section class="py-5 bg-light">
        <div class="container">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h2 class="h3 mb-0">
                    <i class="fas fa-clock text-primary @(dir == "rtl" ? "ms-2" : "me-2")"></i>
                    @LocalizationHelper.GetText("RecentBooks", Context)
                </h2>
                <a asp-controller="Book" asp-action="Index" class="btn btn-outline-primary">
                    @LocalizationHelper.GetText("ViewAll", Context)
                    <i class="fas fa-arrow-@(dir == "rtl" ? "left" : "right") @(dir == "rtl" ? "me-2" : "ms-2")"></i>
                </a>
            </div>
            
            <div class="row g-4">
                @foreach (var book in recentBooks.Take(6))
                {
                    <div class="col-lg-2 col-md-4 col-sm-6">
                        <div class="card card-custom h-100">
                            @if (!string.IsNullOrEmpty(book.CoverImagePath))
                            {
                                <img src="/@book.CoverImagePath" class="card-img-top" style="height: 200px; object-fit: cover;" alt="@book.Title">
                            }
                            else
                            {
                                <div class="bg-secondary d-flex align-items-center justify-content-center" style="height: 200px;">
                                    <i class="fas fa-book fa-3x text-white"></i>
                                </div>
                            }
                            <div class="card-body p-2">
                                <h6 class="card-title mb-1" style="font-size: 0.9rem;">@book.Title</h6>
                                <p class="card-text text-muted mb-0" style="font-size: 0.8rem;">@book.Author</p>
                            </div>
                            <div class="card-footer bg-transparent border-top-0 p-2">
                                <a asp-controller="Book" asp-action="Details" asp-route-id="@book.Id" class="btn btn-sm btn-primary w-100">
                                    @LocalizationHelper.GetText("Details", Context)
                                </a>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </section>
}

<!-- Popular Books Section -->
@if (popularBooks.Any())
{
    <section class="py-5">
        <div class="container">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h2 class="h3 mb-0">
                    <i class="fas fa-fire text-danger @(dir == "rtl" ? "ms-2" : "me-2")"></i>
                    @LocalizationHelper.GetText("PopularBooks", Context)
                </h2>
                <a asp-controller="Book" asp-action="Index" class="btn btn-outline-primary">
                    @LocalizationHelper.GetText("ViewAll", Context)
                    <i class="fas fa-arrow-@(dir == "rtl" ? "left" : "right") @(dir == "rtl" ? "me-2" : "ms-2")"></i>
                </a>
            </div>
            
            <div class="list-group">
                @foreach (var book in popularBooks.Take(5))
                {
                    <a asp-controller="Book" asp-action="Details" asp-route-id="@book.Id" 
                       class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
                        <div class="d-flex align-items-center">
                            <i class="fas fa-book text-primary @(dir == "rtl" ? "ms-3" : "me-3")"></i>
                            <div>
                                <h6 class="mb-0">@book.Title</h6>
                                <small class="text-muted">@book.Author</small>
                            </div>
                        </div>
                        <div>
                            <span class="badge bg-primary">
                                <i class="fas fa-eye @(dir == "rtl" ? "ms-1" : "me-1")"></i>
                                @book.ViewCount
                            </span>
                            <span class="badge bg-success">
                                <i class="fas fa-heart @(dir == "rtl" ? "ms-1" : "me-1")"></i>
                                @book.LikeCount
                            </span>
                        </div>
                    </a>
                }
            </div>
        </div>
    </section>
}

<!-- Statistics Section -->
<section class="py-5 bg-light">
    <div class="container">
        <div class="row text-center">
            <div class="col-md-3 mb-4">
                <div class="card card-custom border-0 bg-primary text-white">
                    <div class="card-body">
                        <i class="fas fa-book fa-3x mb-3"></i>
                        <h3 class="display-6 fw-bold">@recentBooks.Count()+</h3>
                        <p class="mb-0">@LocalizationHelper.GetText("TotalBooks", Context)</p>
                    </div>
                </div>
            </div>
            <div class="col-md-3 mb-4">
                <div class="card card-custom border-0 bg-success text-white">
                    <div class="card-body">
                        <i class="fas fa-users fa-3x mb-3"></i>
                        <h3 class="display-6 fw-bold">1000+</h3>
                        <p class="mb-0">@LocalizationHelper.GetText("TotalUsers", Context)</p>
                    </div>
                </div>
            </div>
            <div class="col-md-3 mb-4">
                <div class="card card-custom border-0 bg-warning text-white">
                    <div class="card-body">
                        <i class="fas fa-download fa-3x mb-3"></i>
                        <h3 class="display-6 fw-bold">5000+</h3>
                        <p class="mb-0">@LocalizationHelper.GetText("TotalDownloads", Context)</p>
                    </div>
                </div>
            </div>
            <div class="col-md-3 mb-4">
                <div class="card card-custom border-0 bg-info text-white">
                    <div class="card-body">
                        <i class="fas fa-star fa-3x mb-3"></i>
                        <h3 class="display-6 fw-bold">500+</h3>
                        <p class="mb-0">@LocalizationHelper.GetText("TotalComments", Context)</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
